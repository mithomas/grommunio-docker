# ==============================================================================
# Grommunio Debian 13 Container Environment Configuration
# ==============================================================================

# Primary Hostname and Domain
GROMMUNIO_HOST=mail.example.com
GROMMUNIO_DOMAIN=example.com

# Additional Domains for Multi-Domain Aliasing (colon-separated, e.g. domain2.com : domain3.com)
# Any email received for these domains will automatically route to the corresponding user in GROMMUNIO_DOMAIN.
DOMAINS=

TIMEZONE=UTC

# Exposed Host Ports (mapped to container-internal standard services)
# Customize these ports if you need to avoid collisions with existing host services.
BIND_IP=127.0.0.1        # Interface IP to bind exposed ports (default: 127.0.0.1 for local host-only access)
HTTP_PORT=8080          # Webmail, ActiveSync, Autodiscover (mapped to container :8080)
ADMIN_PORT=8081         # Admin Web UI & REST API (mapped to container :8081)
RSPAMD_PORT=11334       # Dedicated Rspamd Web Dashboard & API (mapped to container :11334)
SMTP_PORT=2525          # Inbound mail hand-off from host Exim (mapped to container :2525)

# Bayes Automatic Training Interval (in seconds)
BAYES_SYNC_INTERVAL=300

# Outbound Mail Relay (Gromox forwards outbound mail to host Exim)
RELAY_HOST=host.docker.internal
RELAY_PORT=25

# Database Configuration (External MariaDB / MySQL)
# Provide either TCP (DB_HOST / DB_PORT) OR a mounted Unix socket (DB_SOCKET).
# When DB_SOCKET is set (e.g. /run/mysqld/mysqld.sock), DB_HOST and DB_PORT are ignored.
# Note: In testing mode with the 'mariadb' service profile, use DB_HOST=mariadb
# Passwords (DB_PASSWORD, ADMIN_PASSWORD, RSPAMD_PASSWORD, LDAP_BIND_PASS) are configured in .env.secrets
DB_HOST=mariadb
DB_PORT=3306
#DB_SOCKET=/run/mysqld/mysqld.sock
DB_NAME=grommunio
DB_USER=grommunio

# Mailbox Creation Defaults (applied automatically on startup and new user creation)
DEFAULT_USER_LANG=de_DE
DEFAULT_USER_PRIV_WEB=true
DEFAULT_USER_PRIV_EAS=true
DEFAULT_USER_PRIV_DAV=false
DEFAULT_USER_PRIV_SMTP=false
DEFAULT_USER_PRIV_POP3_IMAP=false
DEFAULT_USER_PRIV_CHANGE_PASSWORD=false
DEFAULT_USER_PRIV_CHAT=false
DEFAULT_USER_PRIV_MEET=false
DEFAULT_USER_PRIV_FILES=false
DEFAULT_USER_PRIV_ARCHIVE=false
DEFAULT_USER_CREATE_CHAT_USER=false
# Mailbox Quota Defaults (0 = unlimited; supports units like 10G, 500M, 10485760KB, or integer KiB)
# MAPI hierarchy rule: Storage Quota > Receive Quota > Send Quota
DEFAULT_USER_STORAGE_QUOTA=0
DEFAULT_USER_SEND_QUOTA=0
DEFAULT_USER_RECEIVE_QUOTA=0

# LDAP / OpenLDAP Authentication & Directory Configuration
# Note: In testing mode with the 'openldap' companion service profile, use LDAP_HOST=ldap://openldap:389
# LDAP_PORT configures the host-mapped port for the companion OpenLDAP service (defaults to 389).
LDAP_PORT=389
LDAP_ENABLED=true
LDAP_HOST=ldap://openldap:389
LDAP_START_TLS=false
LDAP_BIND_USER=cn=admin,dc=example,dc=com
LDAP_SEARCH_BASE=dc=example,dc=com
LDAP_USER_FILTER=(objectClass=posixAccount)
LDAP_OBJECT_ID=entryUUID
LDAP_MAIL_ATTR=mail
LDAP_USER_ALIASES=mailAlternativeAddress
LDAP_USER_DISPLAYNAME=displayName
LDAP_USER_ALTNAME=uid
LDAP_GROUP_MEMBER_ATTR=memberOf
LDAP_GROUP_ADDR=mailPrimaryAddress
LDAP_GROUP_FILTER=(objectclass=posixgroup)
LDAP_GROUP_NAME=cn
