# ==============================================================================
# Grommunio Container Secrets Configuration
# Copy to .env.secrets and restrict permissions (chmod 600 .env.secrets)
#
# IMPORTANT - Passwords with special characters ($, #, ', ", \, ;):
# - Enclose passwords containing $, #, ', ", or spaces in single quotes: 'your$p@ss#word'
# - Single quotes prevent Docker Compose from interpreting $ as variable interpolation
#   (which produces warnings like `The "MB" variable is not set` and blanks out characters)
#   and # as inline comments.
# - If your password contains a literal single quote, escape it as \' (e.g. 'my$pass\'word#123').
# ==============================================================================

# MariaDB / MySQL User Password
DB_PASSWORD=grommunio_secret

# Only used by the optional 'mariadb' companion container (--profile test).
# Not used by the grommunio container; omit in production setups.
DB_ROOT_PASSWORD=root_secret

# Initial Admin Password (for Grommunio Admin UI user 'admin')
ADMIN_PASSWORD=admin_secret

# Dedicated Rspamd Dashboard Password (for http://localhost:11334/)
RSPAMD_PASSWORD=rspamd_secret

# LDAP Bind Password (for LDAP_BIND_USER)
LDAP_BIND_PASS=ldap_secret
